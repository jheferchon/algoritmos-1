Algoritmo Metros_A_pulgadas
	Mostrar "Fecha: ", FechaActual()
	Mostrar "Hora: ", HoraActual()
	Mostrar "Jheferson Saucedo"
		
		Definir metros, pulgadas Como Real
		
		Escribir "Ingrese la cantidad de metros:"
		Leer metros
		
		pulgadas <- metros * 39.37
		
		Escribir "Equivalente en pulgadas: ", pulgadas
		
FinAlgoritmo
	

